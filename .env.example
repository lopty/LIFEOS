# Copy this file to .env and paste your Google AI Studio key here.
# This key is used only by the Node server, never by the browser.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_MS=30000
PORT=3000
# Optional: isolate the database when testing or deploying.
LIFEOS_DATA_DIR="./data"
# Demo profiles are available only in local development by default.
# ENABLE_DEMO=true
